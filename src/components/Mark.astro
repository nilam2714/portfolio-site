---
const { size = 36, light = false } = Astro.props;
const bracket = light ? '#F3F5FB' : '#0E1A3D';
---
<svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <path d="M22 22 L6 50 L22 78" fill="none" stroke={bracket} stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M78 22 L94 50 L78 78" fill="none" stroke={bracket} stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
  <polygon points="50,18 30,40 50,40" fill="#7FA2FF"/>
  <polygon points="50,18 70,40 50,40" fill="#3355E8"/>
  <polygon points="30,40 50,40 50,82" fill="#2445D6"/>
  <polygon points="50,40 70,40 50,82" fill="#14246F"/>
</svg>
